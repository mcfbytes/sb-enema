# EFI and secure boot helpers
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_PARTITION=y

# DMI/SMBIOS sysfs exposure
# CONFIG_DMIID populates /sys/class/dmi/id/ (bios_vendor, board_name, etc.)
# CONFIG_DMI_SYSFS exposes raw DMI tables under /sys/firmware/dmi/entries/ only.
CONFIG_DMIID=y
CONFIG_DMI_SYSFS=y

# Filesystem support
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Loop devices for image staging
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y

# Overlay filesystem (read-only rootfs + mutable upper layer)
CONFIG_OVERLAY_FS=y

# Just run the kernel directly -- no GRUB
#
# Both consoles are listed so kernel messages are mirrored to the serial port,
# which is what makes an automated QEMU boot test possible (the image is
# otherwise only observable through the VGA framebuffer).
#
# Order matters and tty0 must stay LAST: /dev/console follows the final
# console= argument, and the getty in inittab is attached to `console`. Putting
# ttyS0 last would move the interactive session to the serial port, so a real
# machine with no usable serial port would show nothing on screen. A second,
# independent getty is attached to ttyS0 by post-build.sh instead.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="rdinit=/init initrd=\\rootfs.cpio.gz console=ttyS0,115200 console=tty0"
CONFIG_CMDLINE_OVERRIDE=y

# 8250 serial support, required for the console= above to have anywhere to go.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

# Framebuffer: EFI GOP only (VESA and simple-fb are legacy/ARM and can race
# with FB_EFI on UEFI-booted x86, producing a blank screen).
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# DRM simple framebuffer driver: preferred 6.x path for UEFI GOP handoff.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y

# USB support
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y

# Input for keyboard
CONFIG_HID=y
CONFIG_USB_HID=y
CONFIG_INPUT_KEYBOARD=y

# HW Random support
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_INTEL=y
CONFIG_HW_RANDOM_AMD=y

# Remove unnecessary kernel options
CONFIG_KEXEC=n
CONFIG_CRASH_DUMP=n
CONFIG_AUDIT=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
